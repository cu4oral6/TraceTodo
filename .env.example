# ============================================================================
# Trace-Memory 配置模板
# 默认无需填写 API Key 即可使用内置确定性离线引擎 (mock) 运行全部功能、Web 面板与测试
# ============================================================================

# 默认空间/租户隔离 ID
TRACE_MEMORY_DEFAULT_SPACE=default

# 数据与派生视图目录
TRACE_MEMORY_DATA_DIR=./data
TRACE_MEMORY_KNOWLEDGE_DIR=./knowledge

# 向量数据库后端: sqlite (零依赖内置余弦向量库, 默认) | qdrant (Qdrant 本地嵌入式 HNSW 或远程服务)
TRACE_MEMORY_VECTOR_BACKEND=sqlite
# 若使用 qdrant: 留空 URL 则使用本地磁盘持久化目录 ./data/qdrant; 填写 URL 则连接远程 Qdrant Server
TRACE_MEMORY_QDRANT_PATH=./data/qdrant
TRACE_MEMORY_QDRANT_URL=
TRACE_MEMORY_QDRANT_API_KEY=

# 模型与 Embedding 驱动模式: mock (离线确定性引擎, 默认) | openai (兼容 OpenAI / DeepSeek / Qwen)
TRACE_MEMORY_LLM_PROVIDER=mock
TRACE_MEMORY_OPENAI_BASE_URL=https://api.deepseek.com/v1
TRACE_MEMORY_OPENAI_API_KEY=
TRACE_MEMORY_LLM_MODEL=deepseek-chat
# 多模态视觉模型（DashScope 百炼 OpenAI 兼容接口推荐 qwen-vl-plus / qwen-vl-max；mock 模式自动离线兜底）
TRACE_MEMORY_VISION_MODEL=qwen-vl-plus
# 短语音兜底转写模型（浏览器不支持 Web Speech API 时调用，转完即删临时音频）
TRACE_MEMORY_ASR_MODEL=whisper-1
TRACE_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
TRACE_MEMORY_EMBEDDING_DIM=128
# 纯语义命中（无 BM25 关键词命中）的最低余弦分；openai 兼容 provider 默认 0.50，mock 默认 0（关闭）
# TRACE_MEMORY_VECTOR_ONLY_MIN_SCORE=0.50

# ReMe 风格 Dream 归纳预算熔断配置
TRACE_MEMORY_DREAM_MAX_LLM_CALLS=5
TRACE_MEMORY_DREAM_MAX_TOKENS=8000

# 检索与双链图谱展开预算配置
TRACE_MEMORY_GRAPH_MAX_HOPS=2
TRACE_MEMORY_GRAPH_MAX_NODES=10
TRACE_MEMORY_GRAPH_MAX_CHARS=4000

# Web 控制台监听地址
TRACE_MEMORY_WEB_HOST=127.0.0.1
TRACE_MEMORY_WEB_PORT=18090

# 多用户鉴权与初始管理员（公网部署建议设为 true）
TRACE_MEMORY_AUTH_REQUIRED=false
TRACE_MEMORY_ALLOW_REGISTRATION=true
TRACE_MEMORY_ADMIN_USERNAME=
TRACE_MEMORY_ADMIN_PASSWORD=
TRACE_MEMORY_SESSION_TTL_HOURS=720

# 低成本防线与每日配额保护
TRACE_MEMORY_NOISE_FILTER_ENABLED=true
TRACE_MEMORY_MAX_NOTE_CHARS=2000
TRACE_MEMORY_MIN_MEANINGFUL_CHARS=3
TRACE_MEMORY_RATE_LIMIT_PER_MINUTE=25
TRACE_MEMORY_DUPLICATE_WINDOW_SECONDS=120
TRACE_MEMORY_DAILY_NOTE_LIMIT=60
TRACE_MEMORY_DAILY_LLM_LIMIT=80
TRACE_MEMORY_DAILY_TOKEN_LIMIT=100000
# 单空间图片附件磁盘配额上限 (MB，原图与缩略图存磁盘目录，不进 SQLite)
TRACE_MEMORY_SPACE_MEDIA_QUOTA_MB=50
